# openbao/config.azure.hcl.EXAMPLE — OpenBao auto-unseal via Azure Key Vault.
#
# *** TEMPLATE — verify against YOUR real Key Vault before relying on it. ***
# The seal MECHANISM is proven (see compose.transit.yaml); this swaps the dev
# transit seal for Azure Key Vault. It CANNOT be live-verified without a real
# Vault. Copy to openbao/config.azure.hcl, set the AZURE_* / VAULT_* vars in .env,
# run ./check-azure-kms.sh, then bring it up and confirm it auto-unseals.
#
# Used with BAO_AUTO_UNSEAL=1 (openbao/entrypoint.sh): the master key is held by
# Azure Key Vault and NEVER persisted next to the data.

# Integrated (raft) storage — the supported production backend (the dev stack
# uses `file`, which OpenBao deprecates by v2.7).
storage "raft" {
  path    = "/openbao/data"
  node_id = "openbao-1"
}

listener "tcp" {
  address     = "0.0.0.0:8200"
  tls_disable = true   # PRODUCTION: terminate TLS here or at a trusted proxy.
}

api_addr     = "http://openbao:8200"
cluster_addr = "http://openbao:8201"

# Azure Key Vault seal. All parameters are read from the environment, so secrets
# never live in this file — set them in .env; compose.azure-kms.yaml passes them
# in. Env vars: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET (omit for a
# managed identity), VAULT_NAME, VAULT_KEY_NAME.
seal "azurekeyvault" {}

disable_mlock = false   # production: allow mlock (grant IPC_LOCK)
ui            = false
