# ── Secrets & local config — NEVER commit these ─────────────────────────────
.env
.env.*
!.env.example
*.secret
secrets.json

# ── Key material (the app generates RSA keys at runtime) ─────────────────────
*.pem
*.key
keys/
.keys/
/data/keys/

# ── OpenBao / Vault local state ─────────────────────────────────────────────
.bao-token
.vault-token
bao
vault

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# ── Test / coverage artifacts ───────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── Container build context leftovers ───────────────────────────────────────
*.log
