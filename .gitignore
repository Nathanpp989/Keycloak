# ── Secrets & local config — NEVER commit these ─────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example
*.secret
secrets.json

# ── Key material (the app generates RSA keys at runtime) ─────────────────────
*.pem
*.key
keys/
.keys/
/data/keys/

# ── OpenBao / Vault local state ─────────────────────────────────────────────
.bao-token
.vault-token
bao
vault

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# ── Test / coverage artifacts ───────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── Container build context leftovers ───────────────────────────────────────
*.log

# OpenBao-issued Traefik certs (generated by openbao_traefik_cert.py) — never commit keys
traefik/dynamic/openbao-cert.pem
traefik/dynamic/openbao-key.pem
traefik/dynamic/tls-openbao.yml

# Persistent OpenBao init material (unseal key + root token) — never commit.
# Normally lives in the openbao-data Docker volume, not the repo, but guard
# against an accidental bind-mount or local copy.
openbao/bao-init.json
**/bao-init.json
premalytics-broker-synced.tar.gz
MANIFEST.txt
.env.broken.bak
