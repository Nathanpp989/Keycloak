# ── Secrets & local config — NEVER commit these ─────────────────────────────
.env
.env.*
*.env
*.env.*
!.env.example
*.secret
secrets.json

# ── Key material (the app generates RSA keys at runtime) ─────────────────────
*.pem
*.key
keys/
.keys/
/data/keys/

# ── OpenBao / Vault local state ─────────────────────────────────────────────
.bao-token
.vault-token
bao
vault

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# ── Test / coverage artifacts ───────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── Logs & build artifacts ──────────────────────────────────────────────────
*.log
# Release/export tarballs are build artifacts, not source.
*.tar.gz

# ── Runtime-generated Traefik dynamic config — never commit ─────────────────
# mTLS overlay is written by enable-mtls.sh at runtime; the committed template
# is traefik/dynamic/mtls.yml.example.
traefik/dynamic/mtls.yml
# OpenBao-issued Traefik certs (generated by openbao_traefik_cert.py).
traefik/dynamic/openbao-cert.pem
traefik/dynamic/openbao-key.pem
traefik/dynamic/tls-openbao.yml

# ── Kubernetes real secret (committed template is k8s/secret.example.yaml) ───
k8s/secret.yaml

# Persistent OpenBao init material (unseal key + root token) — never commit.
# Normally lives in the openbao-data Docker volume, not the repo, but guard
# against an accidental bind-mount or local copy.
openbao/bao-init.json
**/bao-init.json
bin/
LICENSE.txt
.DS_Store
