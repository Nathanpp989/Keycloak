\# Build-context exclusions for the auth broker image.
# Goal: ship ONLY what the running service imports (main.py's transitive
# module graph + requirements.txt). Everything here is a test, a dev/CI tool,
# a cross-project file, a secret, or build junk — none belong in the image.
# container_check.py enforces this (test_real_project_passes_all_container_checks).

# ── tests (pull in pytest/responses, never run in the image) ──
test_*.py
*_test.py
conftest.py
pytest.ini
.pytest_cache/
.coverage
htmlcov/

# ── dev / diagnostic / CI tooling (not part of the running service) ──
container_check.py
auth_probe.py
connectivity.py
diagnose_idp.py
login_flow.py
fix_redirect_uri.py
endpoint_smoke.py
live_smoke.py
e2e_smoke.py
integration_test_live.py
auth0_endpoints_live.py
auth0_pagination_live.py

# ── cross-project files that landed in this directory ──
# (the PremDispatch broker + its MCP tooling — a different service)
premdispatch_server.py
mcp_server.py
rag_ingest.py
MCP_server_layer/

# ── secrets & local config — must NEVER enter the build context ──
.env
.env.*
*.pem
*.key
*.p12

# ── VCS / CI / editor / build junk ──
.git/
.github/
.gitignore
*.yml
*.yaml
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
