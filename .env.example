# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Only the values relevant to the features you use are required.

# ── Auth0 (M2M app: Management API + the Auth0 side of brokered login) ───────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-m2m-client-id
AUTH0_CLIENT_SECRET=your-m2m-client-secret
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_CALLBACK_URL=http://localhost:8080/realms/Premkey/broker/auth0/endpoint
AUTH0_IDP_ALIAS=auth0
AUTH0_AUTHZ_EXTENSION_URL=

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=Premkey
KEYCLOAK_CLIENT_ID=Hello-World-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master
APP_REDIRECT_URI=http://localhost:8000/callback

# ── OpenBao (the "Z-axis" — alongside Key Vault, not replacing it) ───────────
# Local dev server: bao server -dev -dev-root-token-id=root
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=
OPENBAO_KEYCLOAK_MOUNT=oidc
OPENBAO_AUTH0_MOUNT=auth0-jwt
OPENBAO_KV_MOUNT=secret
OPENBAO_KC_CLIENT_ID=openbao
OPENBAO_KC_CLIENT_SECRET=
# Which secrets resolve from OpenBao FIRST (Key Vault stays the fallback).
# Comma-separated names, or * for all. EMPTY = Key Vault only (default).
# Migrate incrementally: add one name, verify, add more.
OPENBAO_SECRETS=

# ── Runtime on/off control (features.py) ────────────────────────────────────
# on = always; off = never; auto = only if configured AND reachable (default).
OPENBAO_MODE=auto
AUTH0_MANAGEMENT_MODE=auto
# Seconds to cache a reachability probe.
FEATURE_PROBE_TTL=30
# false = start in DEGRADED mode if Keycloak is unreachable (dev/diagnosis).
# Default true = refuse to start, since Keycloak is core.
KEYCLOAK_REQUIRED=true

# ── Rate limiting (rate_limit.py) — abuse protection on /token and /register ─
# Per-IP sliding window. Defaults are well above human use, below brute-force.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=60
# Only set true if behind a TRUSTED proxy that sets X-Forwarded-For; otherwise
# the header is spoofable and must be ignored.
RATE_LIMIT_TRUST_PROXY=false

# ── Azure Key Vault (existing secret store) ─────────────────────────────────
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# ── WebSocket GitHub relay (optional) ───────────────────────────────────────
# Move to Key Vault / OpenBao for production rather than an env var.
GITHUB_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────────
DEFAULT_USER_PASSWORD=change-me
NEW_USER_EMAIL=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
KEYCLOAK_STARTUP_RETRIES=10
KEYCLOAK_STARTUP_BACKOFF=2.0

# ── Tooling only (pass inline when running a tool; not app config) ──────────
# endpoint_smoke.py: a real brokered token, or Keycloak creds for direct grant.
APP_TOKEN=
APP_URL=http://localhost:8000
KC_USER=
KC_PASS=
SMOKE_LOOKUP_EMAIL=
# login_flow.py: set to 1 to run the local callback catcher.
LOGIN_FLOW_CATCH=
# Override which .env file is loaded.
DOTENV_PATH=
