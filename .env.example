# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Only the values relevant to the features you use are required.

# ── Auth0 (M2M app: Management API + the Auth0 side of brokered login) ───────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-m2m-client-id
AUTH0_CLIENT_SECRET=your-m2m-client-secret
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
AUTH0_CALLBACK_URL=http://localhost:8080/realms/Premkey/broker/auth0/endpoint
AUTH0_IDP_ALIAS=auth0
AUTH0_AUTHZ_EXTENSION_URL=

# ── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=Premkey
KEYCLOAK_CLIENT_ID=Hello-World-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_REALM=master
APP_REDIRECT_URI=http://localhost:8000/callback

# ── OpenBao (the "Z-axis" — alongside Key Vault, not replacing it) ───────────
# Local dev server: bao server -dev -dev-root-token-id=root
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=
OPENBAO_KEYCLOAK_MOUNT=oidc
OPENBAO_AUTH0_MOUNT=auth0-jwt
OPENBAO_KV_MOUNT=secret
OPENBAO_KC_CLIENT_ID=openbao
OPENBAO_KC_CLIENT_SECRET=
# Which secrets resolve from OpenBao FIRST (Key Vault stays the fallback).
# Comma-separated names, or * for all. EMPTY = Key Vault only (default).
# Migrate incrementally: add one name, verify, add more.
OPENBAO_SECRETS=

# ── OpenBao AppRole (least-privilege auth for the broker, instead of a root
#    token). Provisioned by openbao_setup.py; the role/secret IDs are injected
#    at deploy time (ideally response-wrapped). Leave blank to use OPENBAO_TOKEN.
OPENBAO_APPROLE_MOUNT=approle
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_SECRET_ID_TTL=
OPENBAO_SECRET_ID_NUM_USES=

# ── OpenBao PKI (internal CA that issues the Traefik mTLS / TLS certs) ───────
OPENBAO_PKI_MOUNT=pki
OPENBAO_CERT_KEY_TYPE=rsa
OPENBAO_CERT_KEY_BITS=2048

# ── OpenBao dynamic database secrets (short-lived Postgres creds) ────────────
# Enabled/provisioned by openbao_dynamic_secrets.py + provision_dynamic_secrets.py.
DB_CONNECTION_NAME=broker-postgres
DB_DYNAMIC_ROLE=broker-app
DB_DEFAULT_TTL=1h
DB_MAX_TTL=24h

# ── Postgres (used by the dynamic-secrets engine and compose.postgres.yaml) ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=broker
POSTGRES_USER=broker
POSTGRES_ADMIN_PASSWORD=change-me

# ── Runtime on/off control (features.py) ────────────────────────────────────
# on = always; off = never; auto = only if configured AND reachable (default).
OPENBAO_MODE=auto
AUTH0_MANAGEMENT_MODE=auto
# Seconds to cache a reachability probe.
FEATURE_PROBE_TTL=30
# false = start in DEGRADED mode if Keycloak is unreachable (dev/diagnosis).
# Default true = refuse to start, since Keycloak is core.
KEYCLOAK_REQUIRED=true

# ── Rate limiting (rate_limit.py) — abuse protection on /token and /register ─
# Per-IP sliding window. Defaults are well above human use, below brute-force.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW=60
# Only set true if behind a TRUSTED proxy that sets X-Forwarded-For; otherwise
# the header is spoofable and must be ignored.
RATE_LIMIT_TRUST_PROXY=false
# memory (default, per-process) or redis (shared across replicas).
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://redis:6379/0

# ── Account lockout (account_lockout.py) — brute-force throttle per account ──
LOCKOUT_ENABLED=true
# memory (default) or redis (shared across replicas; uses REDIS_URL).
LOCKOUT_BACKEND=memory

# ── API keys (api_keys.py) — long-lived programmatic credentials ─────────────
# memory (default) or redis (shared across replicas; uses REDIS_URL).
API_KEY_BACKEND=memory

# ── Authorization roles (authz.py) ───────────────────────────────────────────
ADMIN_ROLE=admin
SUPERADMIN_ROLE=superadmin
# Comma-separated roles permitted to call the service-account/token-exchange path.
SERVICE_ACCOUNT_ROLE=service-account
SERVICE_ACCOUNT_AUDIENCE=
# true = scope non-admin users to their own tenant/org on list endpoints.
USER_TENANT_SCOPING=false

# ── HTTP hardening (main.py) ─────────────────────────────────────────────────
# Comma-separated allowed origins for CORS, or * (dev only).
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# Send HSTS header (only when served over real HTTPS).
SECURITY_HSTS=false
# Signing/session secret — generate a strong random value in production.
SECRET_KEY=change-me
# Expose the interactive API docs (/docs, /redoc). Disable in production.
DOCS_ENABLED=true
APP_AUDIENCE=
APP_VERSION=

# ── Azure Key Vault (existing secret store) ─────────────────────────────────
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# ── WebSocket GitHub relay (optional) ───────────────────────────────────────
# Move to Key Vault / OpenBao for production rather than an env var.
GITHUB_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────────
DEFAULT_USER_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_USER_PASSWORD=change-me
NEW_USER_EMAIL=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# text (default) or json (structured logs for aggregation).
LOG_FORMAT=text
KEYCLOAK_STARTUP_RETRIES=10
KEYCLOAK_STARTUP_BACKOFF=2.0

# ── Tooling only (pass inline when running a tool; not app config) ──────────
# endpoint_smoke.py: a real brokered token, or Keycloak creds for direct grant.
APP_TOKEN=
APP_URL=http://localhost:8000
KC_USER=
KC_PASS=
SMOKE_LOOKUP_EMAIL=
# mcp_server.py: how it reaches the broker.
BROKER_URL=http://localhost:8000
BROKER_TOKEN=
BROKER_VERIFY=true
# login_flow.py: set to 1 to run the local callback catcher.
LOGIN_FLOW_CATCH=
# Override which .env file is loaded.
DOTENV_PATH=
